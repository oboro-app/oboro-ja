{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-4.6",
  "small_model": "zai-coding-plan/glm-4.5-air",
  "formatter": true,
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".github/workflows/*",
      "effect": "deny"
    }
  ]
}
